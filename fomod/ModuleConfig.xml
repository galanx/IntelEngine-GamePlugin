<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
    <moduleName>IntelEngine v3.8.2</moduleName>
    <moduleImage path="fomod\IE-cover.jpg" />

    <requiredInstallFiles>
        <file source="IntelEngine.esp" destination="IntelEngine.esp" />
        <folder source="Scripts" destination="Scripts" />

        <folder source="Interface" destination="Interface" />
        <folder source="SKSE" destination="SKSE" />
        <folder source="PrismaUI" destination="PrismaUI" />
        <folder source="Magelight" destination="Magelight" />
        <file source="FAQ.md" destination="IntelEngineTools\FAQ.md" />
    </requiredInstallFiles>

    <installSteps order="Explicit">
        <installStep name="IntelEngine">
            <optionalFileGroups order="Explicit">
                <group name="Install" type="SelectAll">
                    <plugins order="Explicit">
                        <plugin name="IntelEngine">
                            <description>AI-powered NPC autonomy for Skyrim, powered by SkyrimNet.

Needs SKSE, SkyrimNet Beta 27+, PapyrusExtender, PapyrusUtil, SkyUI. (Full requirements: the README's Requirements section.)</description>
                            <image path="fomod\IE-cover.jpg" />
                            <files />
                            <typeDescriptor>
                                <type name="Required"/>
                            </typeDescriptor>
                        </plugin>
                    </plugins>
                </group>
            </optionalFileGroups>
        </installStep>
        <installStep name="Upgrading from IntelEngine 3.5.2 or earlier">
            <optionalFileGroups order="Explicit">
                <group name="Upgrade tools" type="SelectAll">
                    <plugins order="Explicit">
                        <plugin name="Legacy save converter (separate download)">
                            <description>ONLY for saves from IntelEngine 3.5.2 or earlier.
Fresh games: skip this.
Download the converter and its steps here:
https://github.com/galanx/IntelEngine-GamePlugin/releases/tag/save-converter-1</description>
                            <image path="fomod\IE-converter.jpg" />
                            <files />
                            <typeDescriptor>
                                <type name="Required"/>
                            </typeDescriptor>
                        </plugin>
                    </plugins>
                </group>
            </optionalFileGroups>
        </installStep>
    </installSteps>

</config>
